# ELVTERA — Environment Variables Example
# Copy this file to .env.local and fill in your actual keys before running.
# NEVER commit .env.local to version control.

# ── Resend Email API ────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email routing ───────────────────────────────────────────────────────────
SALES_EMAIL=hello@elvtera.com
GENERAL_EMAIL=hello@elvtera.com
VITE_SALES_EMAIL=hello@elvtera.com
VITE_GENERAL_EMAIL=hello@elvtera.com

# ── Calendar booking ────────────────────────────────────────────────────────
CALENDLY_URL=https://cal.com/elvtera-business-solutions-uwltid/30min
NEXT_PUBLIC_CALENDLY_URL=https://cal.com/elvtera-business-solutions-uwltid/30min
